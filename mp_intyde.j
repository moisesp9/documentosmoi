set RELNAME = "INTYDE"

source $SPECPATH/src/param/param_scripts/JOB_PART1


$P/bq >>& $JL                        <<BQEND

rel INTYDE
exe job $0

x
BQEND

set JOBST = $status
source $SPECPATH/src/param/param_scripts/JOB_PART2

exit

$BQ
rel INTYDE
open
clear

.Infotype=  1 { Name='DeviComp'      logon/off                        }
.ValNumCo=  0          { offset of value-name no. if commands (VaName)}
.ValNum  =  68         { offset of value-name no.             (VaName)}

.AnzLisbe=  1             { number of valid blocks  in LISBE          }
  .LisBe[1].LiNu  = 56           {list number                         }
  .LisBe[1].ekommt= true         {insert if appearing /fleeting       }
  .LisBe[1].egeht = true         {insert of disappearing              }
  .LisBe[1].mobau = 6            {number of module                    }

.AnzDrube=  0             { number of valid blocks  in DRUBE          }

.dynamisch        = true     {info value in NIM info string            }
.ferngesteuert    = false    {info is for remote control function      }
.ferngemeldet     = false    {info is telesignalled                    }
.StatusTyp        = devstm   {fleetin/singlep/doublepole/numeric       }
.Befehlsrueckmeld = false    {info is also remote control reply        }
.RcCommandDuration= 0        {command output duration code for SINAUT  }
.RcComReplyTimeout= 0        {superv. time in sec. for command replys  }
.TopoRelevance    = false    {info status change is relevant for topol.}
.NCoRelevance     = false    {info status change is rel. f. cntrl (NCO)}
.Archivieren      = true     {info change into archive spontaneously   }
.AnzeigeGrafik    = true     {display spontaneous info change on VDU   }
.SignStayGr       = false    {selection guidance for app.event on VDU  }
.SignAcknGr       = false    {selection guidance for acknowl.event VDU }
.AckLiKom         = false    {info change is to ackowl.in lists if APP }
.AckLiGeh         = false    {info change is to ackowl.in lists if DISP}
.AckGrafLi        = false    {common acknolwl. graphic --> list        }
.AckLigraf        = false    {common acknolwl. list --> graphic        }
.KomGeh           = true     {info is appearing-disappearing event     }
.GeneralInqu      = false    {general request if disappearing          }
.MeldeKlasse      = 26       {message class for selection guidance     }
.Priority         = 26        {priority                                 }
.PcJob            = 0        {activation of process controlled NC-Job  }
.ArchModus        = 0        {number of text module for archiving      }
.MailSMSForward   = false    {alarm forwarding to mail/SMS (fotm)      }
.UserProg1        = minObject  {send raw-information to user 1         }
.UserProg2        = minObject  {send raw-information to user 2         }
.UserProg3        = minObject  {send raw-information to user 3         }
.UserProg4        = minObject  {send raw-information to user 4         }
.UserProg5        = minObject  {send raw-information to user 5         }
.EsClassId        = 0        {relevance for ES, assignment to ESOBJ    }
.EsSlotId         = 0        {relevance for ES, assignment to ESOBJ    }
.AlaMesDel        = 0          {delaytime for alarm messages           }
.RcComReplyTimMinu= false;     {time unit for command reply is 1 minute}
.UserSvc1         = s_DACli;    {send raw-information to user Svc 1    }
.UserSvc2         = cMinService;{send raw-information to user Svc 2    }
.UserSvc3         = cMinService;{send raw-information to user Svc 3    }
.UserSvc4         = cMinService;{send raw-information to user Svc 4    }
.RealTimeInty     = 0           {reference to INTYDE for realtime      }
.DistTypNr        = 0        {disturbance type number for DIDATYP      }
write; clear;

